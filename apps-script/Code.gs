/** LabScheduler backend. Spreadsheet is PRIVATE. Deploy web app: Execute as Me, Access Anyone. */
const TAB={users:['username','salt','hash','role','active','equipment','projects'],projects:['id','name','active'],bookings:['id','username','equipment','project','start','end','created_at','status']};
function db_(){const id=PropertiesService.getScriptProperties().getProperty('SHEET_ID');if(!id)throw Error('Execute setup() first');return SpreadsheetApp.openById(id)}
function sheet_(name){return db_().getSheetByName(name)}
function rows_(name){const x=sheet_(name).getDataRange().getValues();return x.slice(1).map((v,i)=>Object.fromEntries(TAB[name].map((k,j)=>[k,v[j]]).concat([['_row',i+2]])))}
function str_(v){return String(v===null||v===undefined?'':v)}
function digest_(s){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,s).map(n=>('0'+(n&255).toString(16)).slice(-2)).join('')}
function hash_(password,salt){const pepper=PropertiesService.getScriptProperties().getProperty('PASSWORD_PEPPER');if(!pepper||pepper.length<32)throw Error('PASSWORD_PEPPER ausente ou curto');let v=salt+'|'+pepper+'|'+password;for(let i=0;i<6000;i++)v=digest_(v);return v}
function token_(){return Utilities.getUuid()+Utilities.getUuid()}
function lock_(fn){const l=LockService.getScriptLock();l.waitLock(20000);try{return fn()}finally{l.releaseLock()}}
function setup(){const props=PropertiesService.getScriptProperties(),u=props.getProperty('ADMIN_USERNAME'),p=props.getProperty('ADMIN_PASSWORD');if(!u||!p||p.length<12)throw Error('Defina ADMIN_USERNAME e ADMIN_PASSWORD (>=12 caracteres) nas Script Properties');if(!props.getProperty('PASSWORD_PEPPER')||props.getProperty('PASSWORD_PEPPER').length<32)throw Error('Defina PASSWORD_PEPPER com 32+ caracteres aleatórios');let id=props.getProperty('SHEET_ID');if(!id){id=SpreadsheetApp.create('LabScheduler - privado').getId();props.setProperty('SHEET_ID',id)}const ss=db_();Object.keys(TAB).forEach(k=>{let sh=ss.getSheetByName(k);if(!sh)sh=ss.insertSheet(k);if(sh.getLastRow()===0)sh.appendRow(TAB[k]);if(k==='bookings')sh.getRange('E:F').setNumberFormat('@')});if(!rows_('users').some(x=>str_(x.username).toLowerCase()===u.toLowerCase())){const salt=token_();sheet_('users').appendRow([u,salt,hash_(p,salt),'admin',true,'*','*'])}props.deleteProperty('ADMIN_PASSWORD');return 'Pronto. Planilha privada: '+ss.getUrl()}
function doGet(){return HtmlService.createHtmlOutputFromFile('Index').setTitle('LabScheduler · Reservas').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)}
function current_(token){if(typeof token!=='string'||token.length<30)return null;const username=CacheService.getScriptCache().get('s_'+digest_(token));if(!username)return null;return rows_('users').find(u=>str_(u.username)===username&&String(u.active).toLowerCase()==='true')||null}
function need_(token){const u=current_(token);if(!u)throw Error('Sessão expirada. Entre novamente.');return u}
function allowed_(csv,value){return str_(csv).split(',').map(x=>x.trim()).includes('*')||str_(csv).split(',').map(x=>x.trim()).includes(value)}
function publicUser_(u){return {username:u.username,role:u.role,equipment:str_(u.equipment).split(','),projects:str_(u.projects).split(',')}}
function login(username,password){username=str_(username).trim();password=str_(password);if(!username||!password)throw Error('Preencha usuário e senha');const cache=CacheService.getScriptCache(),key='fail_'+digest_(username.toLowerCase());const count=Number(cache.get(key)||0);if(count>=8)throw Error('Muitas tentativas. Aguarde 15 minutos.');const u=rows_('users').find(x=>str_(x.username).toLowerCase()===username.toLowerCase()&&String(x.active).toLowerCase()==='true');const candidate=hash_(password,u?str_(u.salt):'dummy-salt');if(!u||candidate!==str_(u.hash)){cache.put(key,String(count+1),900);throw Error('Usuário ou senha inválidos')}cache.remove(key);const token=token_();cache.put('s_'+digest_(token),str_(u.username),21600);return {token,user:publicUser_(u)}}
function logout(token){if(token)CacheService.getScriptCache().remove('s_'+digest_(token));return true}
function state(token){const u=need_(token);const projects=rows_('projects').filter(p=>String(p.active).toLowerCase()==='true').filter(p=>allowed_(u.projects,str_(p.id))).map(p=>({id:p.id,name:p.name}));const equipment=EQUIPMENT.filter(e=>e.bookable&&allowed_(u.equipment,e.code));const bookings=rows_('bookings').filter(b=>b.status==='confirmed').map(b=>({equipment:b.equipment,start:b.start,end:b.end}));return {user:publicUser_(u),equipment,projects,bookings,users:u.role==='admin'?rows_('users').map(x=>({username:x.username,role:x.role,active:x.active,equipment:x.equipment,projects:x.projects})):[]}}
function book(token,equipment,project,start,end){return lock_(()=>{const u=need_(token);const e=EQUIPMENT.find(x=>x.code===equipment&&x.bookable);if(!e||!allowed_(u.equipment,equipment))throw Error('Equipamento não autorizado');if(!rows_('projects').some(p=>p.id===project&&String(p.active).toLowerCase()==='true')||!allowed_(u.projects,project))throw Error('Projeto não autorizado');const pat=/^\d{4}-\d{2}-\d{2}T\d{2}:00$/;if(!pat.test(start)||!pat.test(end)||start>=end||start.slice(0,10)!==end.slice(0,10))throw Error('Intervalo inválido');const h=(Date.parse(end+':00-03:00')-Date.parse(start+':00-03:00'))/3600000;if(h<1||h>12||!Number.isInteger(h))throw Error('Selecione de 1 a 12 horas consecutivas');const now=Utilities.formatDate(new Date(),'America/Sao_Paulo',"yyyy-MM-dd'T'HH:mm");if(start<=now)throw Error('Horário passado');if(rows_('bookings').some(b=>b.status==='confirmed'&&b.equipment===equipment&&str_(b.start)<end&&str_(b.end)>start))throw Error('Conflito: horário já reservado');const id=Utilities.getUuid();sheet_('bookings').appendRow([id,u.username,equipment,project,start,end,new Date().toISOString(),'confirmed']);return {id,start,end}})}
function adminAddUser(token,username,password,role,equipment,projects){return lock_(()=>{const a=need_(token);if(a.role!=='admin')throw Error('Sem permissão');username=str_(username).trim();if(!/^[A-Za-z0-9._-]{3,64}$/.test(username))throw Error('Nome de usuário inválido');if(str_(password).length<12)throw Error('Senha inicial: mínimo de 12 caracteres');if(rows_('users').some(u=>str_(u.username).toLowerCase()===username.toLowerCase()))throw Error('Usuário existente');if(role!=='user'&&role!=='admin')throw Error('Perfil inválido');const salt=token_();sheet_('users').appendRow([username,salt,hash_(password,salt),role,true,str_(equipment),str_(projects)]);return true})}
function adminSetActive(token,username,active){return lock_(()=>{const a=need_(token);if(a.role!=='admin'||a.username===username)throw Error('Operação não autorizada');const u=rows_('users').find(x=>x.username===username);if(!u)throw Error('Usuário não encontrado');sheet_('users').getRange(u._row,5).setValue(!!active);return true})}
function adminAddProject(token,id,name){return lock_(()=>{const a=need_(token);if(a.role!=='admin')throw Error('Sem permissão');id=str_(id).trim();name=str_(name).trim();if(!/^[a-zA-Z0-9_-]{2,60}$/.test(id)||!name||name.length>120)throw Error('Projeto inválido');if(rows_('projects').some(x=>x.id===id))throw Error('Projeto existente');sheet_('projects').appendRow([id,name,true]);return true})}
